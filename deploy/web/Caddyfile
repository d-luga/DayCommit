# Serves the built app inside the Docker network, over plain HTTP.
# TLS and the public domains are handled by the shared edge proxy on the VPS.
{
	admin off
	auto_https off
}

:80 {
	root * /srv/site
	encode zstd gzip

	# Vite puts a content hash in every file name under /assets,
	# so these files never change and can be cached for a year.
	# A missing asset is a real 404, not a fallback to index.html.
	handle /assets/* {
		@found file
		header @found Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, version.txt) is revalidated on every load,
	# so a new deploy shows up right away. Unknown paths fall back to
	# index.html, because routing happens in the browser (single-page app).
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
